  "icons": [
    { "src": "/app-logo.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/app-logo.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "maskable" }
  ]
}
