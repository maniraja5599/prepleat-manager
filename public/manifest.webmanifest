{
  "name": "Saree PrePleat Studio",
  "short_name": "PrePleat Studio",
  "description": "Mobile-first manager for PrePleat & Drape bookings, payments, and customer reminders.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#1c0030",
